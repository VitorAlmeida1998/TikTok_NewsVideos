# APIs / credenciais (nunca commitar o .env real)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# TikTok Content Posting API (preencher quando o módulo publisher for implementado)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Caminho do banco SQLite (opcional, default: data/news.db)
DB_PATH=data/news.db
