# APIs / credenciais (nunca commitar o .env real)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# TikTok Content Posting API — app criado em developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Precisa ser https e bater exatamente com o registrado no app (localhost
# não é aceito). Usado só uma vez pelo setup (uv run python -m publisher.get_token).
TIKTOK_REDIRECT_URI=
# Opcional, default "video.upload" (modo rascunho/inbox). Use "video.publish"
# só se o app tiver esse escopo aprovado pra publicação direta no perfil.
TIKTOK_SCOPE=
# Alternativa manual ao fluxo OAuth acima: cole aqui um access_token já
# emitido (expira em 24h, sem renovação automática). Preferir o fluxo via
# publisher.get_token, que gera um refresh_token válido por 365 dias.
TIKTOK_ACCESS_TOKEN=

# Caminho do banco SQLite (opcional, default: data/news.db)
DB_PATH=data/news.db
